# Copy outside tracked source; generate an alphanumeric password, at least 32 characters.
POSTGRES_PASSWORD=replace-with-an-alphanumeric-private-password
PUBLIC_DOMAIN=api.example.com
MAIL_CONFIG_FILE=/absolute/private/path/mail.private.json
API_IMAGE=mobile-foundry-rust-api:local
# Override these together when the default subnet overlaps another network.
# Keep EDGE_IP inside PRIVATE_SUBNET and outside PRIVATE_IP_RANGE.
# PRIVATE_SUBNET=10.203.241.0/24
# PRIVATE_IP_RANGE=10.203.241.128/25
# EDGE_IP=10.203.241.2
# TRUSTED_PROXY_CIDRS=10.203.241.2/32
