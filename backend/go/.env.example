# Defaults work without a .env file or external services.
APP_ENV=development
HTTP_ADDR=127.0.0.1:8080
LOG_FORMAT=console
LOG_LEVEL=info
AUTH_MODE=deny
# AUTH_MODE=identity selects the owned principal/session authority.
# AUTH_MODE=development requires the paired DEV fixture settings below.

# memory (default) or postgres. Make supplies this local URL; shells must export it.
STORAGE=memory
# DATABASE_URL=postgres://mobile_foundry:local-development-only@127.0.0.1:58432/mobile_foundry?sslmode=disable
# ACCOUNT_DATABASE_URL=...
# AUDIT_DATABASE_URL=...
# IDENTITY_DATABASE_URL=...
# NOTES_DATABASE_URL=...
# make db-up; make migrate; STORAGE=postgres make dev

# Optional single-credential fixture: paired values, development/test, loopback only.
# Set AUTH_MODE=development when enabling these settings in this file.
# DEV_AUTH_TOKEN=local-example-token
# DEV_PRINCIPAL_ID=00000000-0000-4000-8000-000000000001

# PostgreSQL metadata and private local object bytes (retain both for recovery).
# FILES_DATABASE_URL inherits DATABASE_URL when omitted.
FILES_DIRECTORY=.data/files

# Account/principal in-app inbox. Inherits DATABASE_URL when omitted.
# NOTIFICATIONS_DATABASE_URL=...

# Optional real provider preview endpoint; requires AUTH_MODE=identity.
# Copy infra/push/example.json to an untracked private directory; add server keys there.
# PUSH_CONFIG_FILE=.push-private/push.local.json
# Optional queued previews; requires STORAGE=postgres and selected push configuration.
# PUSH_JOBS_ENABLED=true
