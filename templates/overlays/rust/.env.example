# The development Make runner selects Identity; the bare binary defaults to deny.
AUTH_MODE=identity
STORAGE=memory
HTTP_ADDR=127.0.0.1:8080
# Explicit PostgreSQL development uses make db-up migrate; no production secrets.
# STORAGE=postgres
# POSTGRES_PORT=58433
# Optional private operational settings:
# METRICS_ADDR=127.0.0.1:9090
# TRUSTED_PROXY_CIDRS=127.0.0.1/32
# Mail, push and durable jobs need deliberate private configuration; defaults stay off.
