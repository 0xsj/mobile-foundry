# make go-dev selects owned Identity and memory storage; the binary defaults to deny.
# Files are not loaded automatically. Export your chosen values in your shell.
APP_ENV=development
HTTP_ADDR=127.0.0.1:8080
LOG_FORMAT=console
LOG_LEVEL=info
AUTH_MODE=identity
STORAGE=memory
POSTGRES_PORT=58432
# DATABASE_URL=postgres://app:local-development-only@127.0.0.1:58432/app?sslmode=disable
# ACCOUNT_DATABASE_URL=...
# AUDIT_DATABASE_URL=...
# IDENTITY_DATABASE_URL=...
# NOTES_DATABASE_URL=...
# Run make go-db-up go-migrate, then STORAGE=postgres make go-dev.
# Real credentials/passwords belong in untracked environment configuration.

# PostgreSQL metadata and private local object bytes (retain both for recovery).
# FILES_DATABASE_URL inherits DATABASE_URL when omitted.
FILES_DIRECTORY=.data/files

# Account/principal in-app inbox. Inherits DATABASE_URL when omitted.
# NOTIFICATIONS_DATABASE_URL=...

# Optional real provider preview endpoint; requires AUTH_MODE=identity.
# Copy infra/push/example.json to an untracked private directory; add server keys there.
# PUSH_CONFIG_FILE=.push-private/push.local.json
# Optional queued previews; requires STORAGE=postgres and selected push configuration.
# PUSH_JOBS_ENABLED=true
